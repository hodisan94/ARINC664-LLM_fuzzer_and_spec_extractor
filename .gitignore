# =============================================================
# ARINC664 LLM Fuzzer & Spec Extractor
# "Ignore all, allow specific" — only track project files
# =============================================================

# Ignore EVERYTHING by default (ns-3 base files)
*

# =============================================================
# TRACK: Project root files
# =============================================================
!.gitignore
!.env.example

# =============================================================
# TRACK: LLM-Guided Fuzzer
# =============================================================
!llm_fuzzer/
!llm_fuzzer/**

# =============================================================
# TRACK: Specification Extraction Pipeline
# =============================================================
!spec_extraction/
!spec_extraction/**

# =============================================================
# TRACK: Baselines
# =============================================================
!random_baseline/
!random_baseline/**
!boofuzz_baseline/
!boofuzz_baseline/**

# =============================================================
# TRACK: Evaluation
# =============================================================
!evaluation/
!evaluation/**

# =============================================================
# TRACK: Configuration & Data
# =============================================================
!configs/
!configs/**

# =============================================================
# TRACK: Tools, Scripts, Tests
# =============================================================
!tools/
!tools/**
!scripts/
!scripts/**
!tests/
!tests/**

# =============================================================
# TRACK: AFDX Simulator (custom ns-3 module)
# =============================================================
!examples/
!examples/AFDX_V3/
!examples/AFDX_V3/**

# =============================================================
# TRACK: C++ Fuzzing Extensions
# =============================================================
!extensions/
!extensions/**

# =============================================================
# TRACK: Documentation
# =============================================================
!context/
!context/**
!docs/
!docs/**

# =============================================================
# ALWAYS IGNORE (even in tracked directories)
# =============================================================

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Environment
.env
venv/
.venv/

# Build artifacts
build/
*.o
*.so
*.a

# Large binaries
*.pdf

# Logs
*.log

# Runtime data (large/regenerable outputs)
**/checkpoints/
**/iteration_*_test.json
**/demo_history.jsonl
**/multimodel_output/
**/comparison_results.json
**/alignment_results.json
**/arbitration_results.json
**/protocol_rules.json
**/test_case_extraction_checkpoint.jsonl
**/*_run.log

# TRACK experiment data (iteration histories & results)
!**/iteration_history.jsonl
!**/iteration_history_BEFORE_FIX.jsonl
!**/output/*.txt
!**/output/*.csv
!evaluation/results/
!evaluation/results/**

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
