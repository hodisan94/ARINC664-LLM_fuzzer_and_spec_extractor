# =============================================================
# ARINC664 LLM Fuzzer & Spec Extractor
# "Ignore all, allow specific" — only track project files
# =============================================================

# Ignore EVERYTHING by default (ns-3 base files)
*

# =============================================================
# TRACK: Project root files
# =============================================================
!.gitignore
!.env.example

# =============================================================
# TRACK: LLM-Guided Fuzzer
# =============================================================
!llm_fuzzer/
!llm_fuzzer/**

# =============================================================
# TRACK: Specification Extraction Pipeline
# =============================================================
!spec_extraction/
!spec_extraction/**

# =============================================================
# TRACK: Baselines
# =============================================================
!random_baseline/
!random_baseline/**
!boofuzz_baseline/
!boofuzz_baseline/**

# =============================================================
# TRACK: Evaluation
# =============================================================
!evaluation/
!evaluation/**

# =============================================================
# TRACK: Configuration & Data
# =============================================================
!configs/
!configs/**

# =============================================================
# TRACK: Tools, Scripts, Tests
# =============================================================
!tools/
!tools/**
!scripts/
!scripts/**
!tests/
!tests/**

# =============================================================
# TRACK: AFDX Simulators (custom ns-3 modules)
# =============================================================
!examples/
!examples/AFDX_V3/
!examples/AFDX_V3/**
!examples/AFDX_NAV/
!examples/AFDX_NAV/**

# =============================================================
# TRACK: NAV Experiment (supervisor demo)
# =============================================================
!nav_experiment/
!nav_experiment/**

# =============================================================
# TRACK: C++ Fuzzing Extensions
# =============================================================
!extensions/
!extensions/**

# =============================================================
# TRACK: Documentation
# =============================================================
!context/
!context/**
!docs/
!docs/**

# =============================================================
# ALWAYS IGNORE (even in tracked directories)
# =============================================================

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Environment
.env
venv/
.venv/

# Build artifacts
build/
*.o
*.so
*.a

# Large binaries
*.pdf
*.pcap
*.csv

# Logs
*.log

# Runtime data (large/regenerable outputs)
**/checkpoints/
**/iteration_*_test.json
**/demo_history.jsonl
**/test_case_extraction_checkpoint.jsonl
**/test_case_checkpoint.jsonl
**/*_run.log
**/old_extraction_backup/

# TRACK: Multi-model extraction output (new rule extraction results)
!spec_extraction/multimodel_output/
!spec_extraction/multimodel_output/**

# TRACK experiment data (iteration histories & results)
!**/iteration_history.jsonl
!**/output/*.txt
!**/output/*.csv
!evaluation/results/
!evaluation/results/**
!evaluation/results/figures/*.png

# LaTeX paper (managed separately)
Latex/
../Latex/
**/*.tex
!spec_extraction/multimodel_output/validation_table.tex

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
